{
	"settings": {
		"git.path": "C:\\Program Files\\Git\\bin\\bash.exe",
		"terminal.integrated.profiles.windows": {
			"Git Bash": {
				"source": "Git Bash",
				"icon": "terminal-git-bash",
				"path": [
					"C:\\Program Files\\Git\\bin\\bash.exe",
					"${env:USERPROFILE}\\AppData\\Local\\Programs\\Git\\bin\\bash.exe"
				],
				"args": [
					"--login",
					"-i"
				],
				"env": {
					"TMUX": "false"
				}
			},
			"Command Prompt": {
				"path": [
					"${env:windir}\\Sysnative\\cmd.exe",
					"${env:windir}\\System32\\cmd.exe"
				],
				"args": [],
				"icon": "terminal-cmd"
			},
			"PowerShell": {
				"source": "PowerShell",
				"icon": "terminal-powershell"
			}
		},
		"terminal.integrated.shell.windows": "Git Bash",
		"terminal.integrated.defaultProfile.windows": "Git Bash",
		// "terminal.integrated.automationShell.windows": "Git Bash",
		"[txt]": {
			"editor.tabSize": 4,
			"editor.insertSpaces": true,
			"editor.autoIndent": "advanced"
		},
		"[yaml]": {
			"editor.tabSize": 4,
			"editor.insertSpaces": false,
			"editor.autoIndent": "advanced"
		},
		"editor.accessibilityPageSize": 5000,
		"editor.autoIndent": "advanced",
		"editor.autoIndentOnPaste": true,
		"editor.bracketPairColorization.independentColorPoolPerBracketType": true,
		"editor.detectIndentation": false,
		"editor.indentSize": "tabSize",
		"editor.insertSpaces": false,
		"editor.minimap.enabled": false,
		"editor.tabSize": 4,
		"editor.wordWrap": "on",
		"files.eol": "\n",
		"files.insertFinalNewline": false,
		"files.trimFinalNewlines": true,
		"files.trimTrailingWhitespace": true,
		"notebook.insertFinalNewline": false,
		"window.zoomLevel": 0,
		"editor.renderWhitespace": "selection",
		"editor.rulers": [
			80
		],
		"github.copilot.enable": {
			"*": false,
		},
		"chat.disableAIFeatures": false,
		"chat.agent.enabled": false,
		"chat.extensionTools.enabled": false,
		"chat.suggestWidget.enabled": false,
		"github.copilot.nextEditSuggestions.enabled": false,
		"editor.unicodeHighlight.nonBasicASCII": false,
	},
	"folders": [
		{	"path": "."
		},
	]
}
